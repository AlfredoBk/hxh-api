{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["config/**/*.ts", "prisma.config.ts", "prisma/**/*.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "generated"]
}
