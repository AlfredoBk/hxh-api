{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["config/**/*.ts", "prisma/**/*.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["generated", "node_modules"]
}
