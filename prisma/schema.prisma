generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Personagem {
  id         Int      @id @default(autoincrement())
  nome       String
  apelido    String?
  tipoNen    String
  afiliacao  String
  idade      Int?
  descricao  String?
  imagemUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
